# This repository is the live addon folder, so it also holds development files
# that are not part of the shipped addon.  Everything ignored here still exists
# on disk and keeps working in-game; it is simply not published.
#
# What IS shipped (never ignore): LightDamage.toc, Core/, Data/, UI/, Config/,
# Libs/, Textures/, README.md.

# ---------------------------------------------------------------------------
# Development and test infrastructure
# ---------------------------------------------------------------------------
tests/
tools/
# The CI workflow drives tools/test_all.ps1, so it cannot run without the two
# directories above.  Un-ignore all three together if you ever want CI back.
.github/

# ---------------------------------------------------------------------------
# Internal design notes and working documents
# ---------------------------------------------------------------------------
docs/
LightDamage-2.0-Product-Spec.zhCN.md
LightDamage-API-Audit-v1.4.6-vs-current.zhCN.md
changes.diff
*.patch
*.orig
*.rej

